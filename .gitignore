.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory


# ===================================
# IDEs & Editors (编辑器/IDE)
# ===================================
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.history/
*.code-workspace

# JetBrains (IntelliJ, PyCharm, WebStorm, GoLand, etc.)
.idea/
*.iml
*.iws

# Vim / Neovim
*.swp
*.swo
*~

# Sublime Text
*.sublime-project
*.sublime-workspace


# ===================================
# Python
# ===================================
__pycache__/
*.py[cod]
*.so
.Python
venv/
env/
.venv/
build/
dist/
*.egg-info/
pip-log.txt


# ===================================
# Node.js / JavaScript / TypeScript
# ===================================
node_modules/
jspm_packages/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
dist-ssr/
*.local


# ===================================
# Java (Maven / Gradle)
# ===================================
*.class
*.jar
*.war
target/
out/
.gradle/
build/


# ===================================
# Go
# ===================================
/bin/
/pkg/
*.exe
*.test


# ===================================
# Rust
# ===================================
target/
**/*.rs.bk
# Cargo.lock 对于库来说通常需要提交，对于应用可以忽略，按需取消注释：
# Cargo.lock


